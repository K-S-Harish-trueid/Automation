# Copy this file to .env (same folder, project root) and edit values there.
# .env is gitignored -- real values never get committed. Every var below is
# optional; anything left out (or the whole file missing) falls back to the
# exact default that used to be hardcoded in the pipeline stage code, so an
# absent .env changes nothing.
#
# See backend/app/rules_config.py for the full explanation of each one.

# ── Tier 1: clean scalars ──────────────────────────────────────────────
DOB_CUTOFF_DATE=1905-01-01
AGE_OF_MAJORITY=18
NAME_INVALID_LENGTH=1
NOT_COLLECTED_PLACEHOLDER=XXX_NOT_COLLECTED_XXX

# ── Tier 2: small regex/lists -- a typo here silently changes validation
# results instead of erroring, edit carefully. Comma-separated for the list
# values, no spaces needed around commas (they get trimmed either way). ──
PASSPORT_ID_REGEX=[A-Za-z][A-Za-z0-9]{7,8}
NATIONAL_ID_REGEX=\d{12}
PASSPORT_ID_SYNONYMS=passport
NATIONAL_ID_SYNONYMS=national id,nid,nationalid
CIVIL_ID_SYNONYMS=civil id,civilid,civil_id
EXTRA_EMPTY_PLACEHOLDER_VALUES=0,00000,null,none,na,n/a
GENERATED_ID_PREFIX=00
GENERATED_ID_RANDOM_DIGITS=6
